# ---------------------------------------------------------------------------
# qa-flow-hub — example environment
#
# Copy to `.env` and adjust. `.env` is git-ignored: no real secret ever gets
# committed. Generate secrets with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
API_PREFIX=api
LOG_LEVEL=debug
# `json` (one object per line, for a log pipeline) or `pretty` (for a human).
# Unset, it follows NODE_ENV: json in production, pretty elsewhere.
# LOG_FORMAT=pretty
# On SIGTERM the instance answers 503 on /health/ready for this long, so the
# load balancer stops routing to it, then stops accepting and drains.
SHUTDOWN_GRACE_MS=5000

# --- Database --------------------------------------------------------------
# Matches the credentials in docker-compose.yml. Port 5432 is the development
# database; the test database runs on 5433 so a test run never wipes your data.
#
# TWO connections on purpose, and it is the point of Row Level Security:
#
#   DATABASE_URL            the running API. Role `qaflow_app` owns nothing and
#                           can only read and write rows, so the tenant policies
#                           apply to it (PostgreSQL exempts a table's owner).
#   DATABASE_MIGRATION_URL  the owner. Used by `prisma migrate`, the seed and the
#                           test harness, which need to change the schema and to
#                           write across organizations.
#
# The API must never be given the owner URL: a policy the application can bypass
# is decoration. After migrating, give the runtime role its password once:
#
#   APP_DATABASE_PASSWORD=... npm run db:grant-app-role -w @qa-flow-hub/api
#
# Rotating that password is the same command plus a new DATABASE_URL.
POSTGRES_USER=qaflow
POSTGRES_PASSWORD=qaflow
POSTGRES_DB=qa_flow_hub
APP_DATABASE_PASSWORD=replace-me-with-a-local-development-value
DATABASE_URL=postgresql://qaflow_app:replace-me-with-a-local-development-value@localhost:5432/qa_flow_hub?schema=public
DATABASE_MIGRATION_URL=postgresql://qaflow:qaflow@localhost:5432/qa_flow_hub?schema=public
TEST_DATABASE_URL=postgresql://qaflow:qaflow@localhost:5433/qa_flow_hub_test?schema=public
# Throwaway credential the RLS suite uses to connect as `qaflow_app`.
TEST_APP_DATABASE_PASSWORD=qaflow_app_test

# --- Authentication --------------------------------------------------------
# Two different secrets on purpose: leaking the access secret must not let an
# attacker mint refresh tokens. Both must be at least 32 characters. With
# NODE_ENV=production the API also refuses to boot when they are equal, still
# contain a placeholder (replace-me, change-me, ...) or are not random enough —
# the values below are therefore development-only by construction.
JWT_ACCESS_SECRET=replace-me-with-a-long-random-development-value
JWT_REFRESH_SECRET=replace-me-with-another-long-random-development-value
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
INVITATION_TTL_DAYS=7
# Public URL of the web client. Invitation links are built from this value and
# never from a request header, so a forged Host cannot mint a link we would send.
WEB_BASE_URL=http://localhost:5173

# --- Email ------------------------------------------------------------------
# `mock` is the only provider: messages are captured in memory (visible under
# Profile → Notifications → Outbox) and never leave the process. No SMTP,
# no vendor. A real provider is a future value here plus one adapter class.
EMAIL_PROVIDER=mock
EMAIL_FROM=no-reply@qa-flow-hub.local

# --- Evidence storage ------------------------------------------------------
# `local` is the only provider: files land under STORAGE_LOCAL_ROOT (relative
# to the API process cwd; git-ignored), keyed by organization and project. The
# browser never sees that path — bytes are served through the authenticated
# API. An S3-compatible provider is a future value here plus one class.
# Only png/jpeg/gif/webp, txt/log, json and pdf are accepted, at most
# UPLOAD_MAX_SIZE_BYTES each (development default 10 MiB; not a quota).
# `local` writes files under STORAGE_LOCAL_ROOT; `memory` is for tests only and
# refused when NODE_ENV=production. In a container, STORAGE_LOCAL_ROOT must be a
# persistent volume (docker-compose.yml mounts `api-storage`) and is part of
# the backup; /health/ready fails while it is not writable.
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=./var/storage
UPLOAD_MAX_SIZE_BYTES=10485760

# --- HTTP security ---------------------------------------------------------
# Comma-separated list of allowed origins. `*` is accepted in development only:
# CORS is registered with credentials, so in production the schema refuses to
# boot with a wildcard.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# Rate limits are kept in memory, PER INSTANCE: with N replicas the effective
# limit is N times these values. The cluster-wide limit belongs to the edge
# (proxy, CDN, load balancer); see docs/deployment.md.
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
# Stricter budget, per client address, shared by /auth/login, /auth/register
# and /auth/refresh. It complements the per-account lockout above.
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MS=60000
# Number of reverse proxies in front of the API that append to
# X-Forwarded-For. 0 = the API is reached directly and the header is ignored.
# The client address (rate limiting, audit log) is the entry that many hops
# from the right; setting it higher than reality lets clients choose their IP.
TRUST_PROXY=0

# --- Metrics ---------------------------------------------------------------
# GET /metrics in Prometheus text format. Off by default; in production it
# requires METRICS_TOKEN (≥ 32 random characters), sent as
# `Authorization: Bearer <token>`. Labels are method, route template and
# status only — never a tenant, user or entity id.
METRICS_ENABLED=false
# METRICS_TOKEN=

# --- Documentation ---------------------------------------------------------
# Left unset it follows NODE_ENV: on in development, off in production, because
# /docs publishes the whole API surface to anonymous callers. Setting it wins.
SWAGGER_ENABLED=true

# --- Web client ------------------------------------------------------------
VITE_API_PROXY_TARGET=http://localhost:3000
