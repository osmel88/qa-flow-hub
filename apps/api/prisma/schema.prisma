// ---------------------------------------------------------------------------
// qa-flow-hub data model.
//
// Two rules govern this file:
//
//   1. Every functional table carries `organizationId`, even when it could be
//      derived by joining through the project. The redundancy is deliberate:
//      it turns tenant isolation into a single indexed predicate that the
//      repository layer can inject mechanically, with no joins to get wrong.
//
//   2. Anything a user can "delete" but that history depends on is soft
//      deleted (`deletedAt`). Test results and audit entries are never
//      deleted at all.
//
// See docs/domain-model.md and docs/backend-course/09-prisma-schema-and-migrations.md.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

// The URL here is the *owner* connection: it is the one the Prisma CLI uses for
// migrations, introspection and the seed, and those need to change the schema
// and to write across organizations. The running API never uses it — it passes
// `DATABASE_URL` (the `qaflow_app` role, subject to Row Level Security) to the
// client explicitly. See docs/backend-course/13-authorization.md and
// docs/technical-debt.md entry 5.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_MIGRATION_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum OrganizationPlan {
  free
  team
  business
}

/// Six roles, ordered from most to least privileged. Granular per-project
/// permissions are deliberately out of scope for the MVP.
enum OrganizationRole {
  organization_owner
  organization_admin
  project_manager
  qa_lead
  tester
  viewer
}

enum MembershipStatus {
  active
  suspended
}

enum InvitationStatus {
  pending
  accepted
  revoked
  expired
}

enum ProjectStatus {
  active
  archived
}

enum RequirementType {
  user_story
  functional
  non_functional
  epic
  bug_fix
}

enum RequirementStatus {
  draft
  in_review
  approved
  implemented
  obsolete
}

enum Priority {
  critical
  high
  medium
  low
}

enum TestCaseType {
  functional
  regression
  smoke
  integration
  performance
  security
  usability
  exploratory
}

enum TestCaseStatus {
  draft
  active
  deprecated
}

enum AutomationStatus {
  manual
  candidate
  automated
}

enum TestRunStatus {
  planned
  in_progress
  completed
  aborted
}

/// The five outcomes of executing a case. `blocked` (an external cause
/// prevented verification) is kept distinct from `skipped` (the team chose not
/// to verify): conflating them hides environment problems.
enum TestResultStatus {
  untested
  passed
  failed
  blocked
  skipped
}

enum DefectSeverity {
  blocker
  critical
  major
  minor
  trivial
}

enum DefectStatus {
  open
  triaged
  in_progress
  resolved
  closed
  rejected
  reopened
}

/// Entities that can participate in a traceability link or carry an external
/// reference. Kept as an enum rather than a free string so a typo cannot
/// create an orphan link.
enum LinkableEntity {
  requirement
  test_case
  test_run
  test_result
  defect
  project
  automated_test
}

enum TraceLinkType {
  verifies
  covers
  relates_to
  caused_by
  automates
  blocks
}

enum IntegrationProvider {
  jira
  testrail
  github
  github_actions
  playwright
  generic_ci
}

enum IntegrationStatus {
  disconnected
  connected
  error
}

enum AuditAction {
  create
  update
  delete
  archive
  restore
  login
  logout
  invite
  accept_invite
  revoke_invite
  role_change
  execute
  export
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id           String    @id @default(cuid())
  /// Always stored lower-cased and trimmed; the unique index is therefore an
  /// effective case-insensitive constraint without a functional index.
  email        String    @unique
  /// argon2id hash. Never a plaintext or reversible value.
  passwordHash String
  fullName     String
  avatarUrl    String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?

  /// Brute-force protection lives on the user, not in the rate limiter,
  /// because it must survive a restart and be shared across API replicas.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  memberships      OrganizationMember[]
  projectMembers   ProjectMember[]
  sessions         Session[]
  invitationsSent  OrganizationInvitation[] @relation("InvitationCreatedBy")
  auditLogs        AuditLog[]
  assignedRunCases TestRunCase[]            @relation("TestRunCaseAssignee")
  executedResults  TestResult[]             @relation("TestResultExecutedBy")
  reportedDefects  Defect[]                 @relation("DefectReportedBy")
  assignedDefects  Defect[]                 @relation("DefectAssignee")
  uploadedFiles    AttachmentMetadata[]

  @@index([deletedAt])
  @@map("users")
}

/// One row per active refresh-token family. Sessions are revocable, which is
/// the whole reason refresh tokens live in the database instead of being
/// stateless JWTs.
model Session {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// SHA-256 of the refresh token. The plaintext token exists only in the
  /// client; a database dump does not let an attacker mint sessions.
  refreshTokenHash String    @unique
  /// Rotation: every refresh issues a new token and marks the previous one
  /// replaced. Presenting a replaced token means the token leaked, and the
  /// whole family is revoked.
  replacedById     String?   @unique
  familyId         String
  expiresAt        DateTime
  revokedAt        DateTime?
  revokedReason    String?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
  @@map("sessions")
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

model Organization {
  id   String           @id @default(cuid())
  name String
  /// URL-safe identifier, unique across the installation.
  slug String           @unique
  /// Present from day one so that billing becomes a module rather than a
  /// schema migration.
  plan OrganizationPlan @default(free)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  members            OrganizationMember[]
  invitations        OrganizationInvitation[]
  projects           Project[]
  requirements       Requirement[]
  testSuites         TestSuite[]
  testSections       TestSection[]
  testCases          TestCase[]
  testSteps          TestStep[]
  testRuns           TestRun[]
  testRunCases       TestRunCase[]
  testResults        TestResult[]
  defects            Defect[]
  attachments        AttachmentMetadata[]
  traceabilityLinks  TraceabilityLink[]
  auditLogs          AuditLog[]
  integrations       IntegrationConnection[]
  externalReferences ExternalReference[]
  projectMemberships ProjectMember[]

  @@index([deletedAt])
  @@map("organizations")
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  role     OrganizationRole
  status   MembershipStatus @default(active)
  joinedAt DateTime         @default(now())

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  /// A user has exactly one membership per organization, and therefore exactly
  /// one role in it.
  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId, role])
  @@map("organization_members")
}

/// A pending invitation to join an organization. The invitee may not have an
/// account yet, which is why this is keyed by email rather than by user.
model OrganizationInvitation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Normalised (lower-cased, trimmed) before storage.
  email String
  role  OrganizationRole

  /// SHA-256 of the invitation token. The plaintext is generated once, handed
  /// to the caller and never stored; acceptance hashes the presented token and
  /// compares. A leaked database therefore does not yield usable invitations.
  tokenHash String           @unique
  status    InvitationStatus @default(pending)
  expiresAt DateTime

  invitedById String?
  invitedBy   User?   @relation("InvitationCreatedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  acceptedAt       DateTime?
  acceptedByUserId String?
  revokedAt        DateTime?
  /// Bumped on every conceptual "resend", which issues a fresh token.
  resendCount      Int       @default(0)
  lastSentAt       DateTime  @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// At most one *pending* invitation per (organization, email). Enforced as a
  /// partial unique index in the migration, because a plain unique constraint
  /// would also block re-inviting somebody whose invitation was revoked.
  @@index([organizationId, email])
  @@index([status, expiresAt])
  @@map("organization_invitations")
}

// ---------------------------------------------------------------------------
// Projects
// ---------------------------------------------------------------------------

model Project {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name        String
  /// Short uppercase code used to build human-readable keys: WEB-R-14.
  key         String
  description String?
  status      ProjectStatus @default(active)

  /// Monotonic counters for human-readable keys. Incremented inside the same
  /// transaction that creates the entity, so keys never collide and never
  /// reuse a number after a deletion.
  requirementCounter Int @default(0)
  testCaseCounter    Int @default(0)
  defectCounter      Int @default(0)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?
  deletedAt  DateTime?

  members      ProjectMember[]
  requirements Requirement[]
  testSuites   TestSuite[]
  testCases    TestCase[]
  testRuns     TestRun[]
  defects      Defect[]

  @@unique([organizationId, key])
  @@index([organizationId, status])
  @@index([organizationId, deletedAt])
  @@map("projects")
}

model ProjectMember {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      String
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Optional narrowing of the organization role for this project. Null means
  /// "use the organization role".
  role OrganizationRole?

  createdAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([organizationId, userId])
  @@map("project_members")
}

// ---------------------------------------------------------------------------
// Requirements
// ---------------------------------------------------------------------------

model Requirement {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      String
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// Human-readable and stable: WEB-R-14.
  key                String
  title              String
  description        String?
  acceptanceCriteria String?
  type               RequirementType   @default(user_story)
  priority           Priority          @default(medium)
  status             RequirementStatus @default(draft)
  tags               String[]          @default([])

  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  versions RequirementVersion[]

  @@unique([organizationId, projectId, key])
  @@index([organizationId, projectId, status])
  @@index([organizationId, projectId, deletedAt])
  @@map("requirements")
}

/// Append-only history of requirement edits. A separate table rather than a
/// JSON column so that "what did this requirement say in March?" is a query,
/// not a scan.
model RequirementVersion {
  id             String      @id @default(cuid())
  organizationId String
  requirementId  String
  requirement    Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  version     Int
  snapshot    Json
  changedById String?
  changedAt   DateTime @default(now())

  @@unique([requirementId, version])
  @@index([organizationId, requirementId])
  @@map("requirement_versions")
}

// ---------------------------------------------------------------------------
// Test design
// ---------------------------------------------------------------------------

model TestSuite {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      String
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name        String
  description String?
  position    Int     @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  sections  TestSection[]
  testCases TestCase[]

  @@unique([organizationId, projectId, name])
  @@index([organizationId, projectId, deletedAt])
  @@map("test_suites")
}

/// Hierarchical folder inside a suite. Self-referencing; depth is bounded by
/// the service layer rather than by the schema.
model TestSection {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  suiteId        String
  suite          TestSuite    @relation(fields: [suiteId], references: [id], onDelete: Cascade)

  parentId String?
  parent   TestSection?  @relation("TestSectionTree", fields: [parentId], references: [id], onDelete: Cascade)
  children TestSection[] @relation("TestSectionTree")

  name        String
  description String?
  position    Int     @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  testCases TestCase[]

  @@index([organizationId, suiteId, parentId])
  @@map("test_sections")
}

model TestCase {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      String
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  suiteId        String
  suite          TestSuite    @relation(fields: [suiteId], references: [id], onDelete: Cascade)
  sectionId      String?
  section        TestSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  /// Human-readable and stable: WEB-C-102.
  key              String
  title            String
  description      String?
  preconditions    String?
  expectedResult   String?
  type             TestCaseType     @default(functional)
  priority         Priority         @default(medium)
  status           TestCaseStatus   @default(draft)
  automationStatus AutomationStatus @default(manual)
  estimateMinutes  Int?
  tags             String[]         @default([])
  /// Incremented on every edit. Copied into the run snapshot so a report can
  /// state which version of the case was executed.
  version          Int              @default(1)

  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  archivedAt  DateTime?
  deletedAt   DateTime?

  steps        TestStep[]
  testRunCases TestRunCase[]
  defects      Defect[]

  @@unique([organizationId, projectId, key])
  @@index([organizationId, projectId, status])
  @@index([organizationId, suiteId, sectionId])
  @@index([organizationId, projectId, deletedAt])
  @@map("test_cases")
}

model TestStep {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  testCaseId     String
  testCase       TestCase     @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  position       Int
  action         String
  expectedResult String?
  data           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([testCaseId, position])
  @@index([organizationId, testCaseId])
  @@map("test_steps")
}

// ---------------------------------------------------------------------------
// Execution
// ---------------------------------------------------------------------------

model TestRun {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      String
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name        String
  description String?
  /// Free-form release or build identifier; deliberately not a foreign key,
  /// because releases live in the customer's own tooling.
  milestone   String?
  environment String?
  status      TestRunStatus @default(planned)

  startedAt   DateTime?
  completedAt DateTime?

  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  runCases TestRunCase[]
  results  TestResult[]
  defects  Defect[]

  @@index([organizationId, projectId, status])
  @@index([organizationId, projectId, deletedAt])
  @@map("test_runs")
}

/// A test case included in a run. `caseSnapshot` is the reason this table
/// exists: editing a case must never change what a past run reported, so the
/// title, steps and expected results are frozen at inclusion time.
model TestRunCase {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  testRunId      String
  testRun        TestRun      @relation(fields: [testRunId], references: [id], onDelete: Cascade)
  testCaseId     String
  testCase       TestCase     @relation(fields: [testCaseId], references: [id], onDelete: Restrict)

  caseSnapshot Json
  caseVersion  Int

  assignedToId String?
  assignedTo   User?   @relation("TestRunCaseAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  /// Projection of the most recent result, kept so that listing a run does not
  /// require a correlated subquery over the results table.
  latestStatus TestResultStatus @default(untested)
  position     Int              @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  results TestResult[]

  @@unique([testRunId, testCaseId])
  @@index([organizationId, testRunId, latestStatus])
  @@index([organizationId, assignedToId])
  @@map("test_run_cases")
}

/// Append-only. Every execution attempt inserts a row; nothing is ever
/// updated or deleted, because the history is the product.
model TestResult {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  testRunId      String
  testRun        TestRun      @relation(fields: [testRunId], references: [id], onDelete: Cascade)
  testRunCaseId  String
  testRunCase    TestRunCase  @relation(fields: [testRunCaseId], references: [id], onDelete: Cascade)

  status         TestResultStatus
  comment        String?
  /// Per-step outcomes, shaped by the snapshot rather than by the live case.
  stepResults    Json?
  elapsedSeconds Int?

  executedById String?
  executedBy   User?    @relation("TestResultExecutedBy", fields: [executedById], references: [id], onDelete: SetNull)
  executedAt   DateTime @default(now())

  defects Defect[]

  @@index([organizationId, testRunId, status])
  @@index([organizationId, testRunCaseId, executedAt])
  @@map("test_results")
}

// ---------------------------------------------------------------------------
// Defects
// ---------------------------------------------------------------------------

model Defect {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      String
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// Human-readable and stable: WEB-D-7.
  key              String
  title            String
  description      String?
  severity         DefectSeverity @default(major)
  priority         Priority       @default(medium)
  status           DefectStatus   @default(open)
  environment      String?
  stepsToReproduce String?

  /// The origin of the defect. Nullable because a defect can also be raised
  /// outside an execution.
  testResultId String?
  testResult   TestResult? @relation(fields: [testResultId], references: [id], onDelete: SetNull)
  testCaseId   String?
  testCase     TestCase?   @relation(fields: [testCaseId], references: [id], onDelete: SetNull)
  testRunId    String?
  testRun      TestRun?    @relation(fields: [testRunId], references: [id], onDelete: SetNull)

  reportedById String?
  reportedBy   User?   @relation("DefectReportedBy", fields: [reportedById], references: [id], onDelete: SetNull)
  assigneeId   String?
  assignee     User?   @relation("DefectAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  resolvedAt DateTime?
  closedAt   DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([organizationId, projectId, key])
  @@index([organizationId, projectId, status])
  @@index([organizationId, assigneeId, status])
  @@index([organizationId, testResultId])
  @@map("defects")
}

// ---------------------------------------------------------------------------
// Cross-cutting
// ---------------------------------------------------------------------------

/// Metadata only in the MVP: nothing is uploaded anywhere. `storageKey` is the
/// seam for object storage. See docs/technical-debt.md entry 2.
model AttachmentMetadata {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  entityType LinkableEntity
  entityId   String

  fileName    String
  contentType String
  sizeBytes   Int
  checksum    String?
  storageKey  String?

  uploadedById String?
  uploadedBy   User?     @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  @@index([organizationId, entityType, entityId])
  @@map("attachment_metadata")
}

/// One polymorphic table instead of six join tables. Link types will grow
/// (automation, releases, risks); a new type must not require a migration.
model TraceabilityLink {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  sourceType LinkableEntity
  sourceId   String
  targetType LinkableEntity
  targetId   String
  linkType   TraceLinkType

  createdById String?
  createdAt   DateTime @default(now())

  @@unique([organizationId, sourceType, sourceId, targetType, targetId, linkType])
  @@index([organizationId, sourceType, sourceId])
  @@index([organizationId, targetType, targetId])
  @@map("traceability_links")
}

/// Append-only record of who did what. Written by an interceptor, never by
/// hand, and never deleted.
model AuditLog {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  userId         String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  action     AuditAction
  entityType String
  entityId   String?
  summary    String?
  /// Only the fields that changed, with secrets and password hashes removed
  /// before persisting.
  changes    Json?

  ipAddress String?
  userAgent String?
  requestId String?

  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([organizationId, entityType, entityId])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Integrations (contracts only in the MVP)
// ---------------------------------------------------------------------------

/// Configuration of an external system for an organization. Credentials are
/// NOT stored here: `secretRef` points at an entry in a secret manager, so a
/// database dump never yields a customer's Jira token.
model IntegrationConnection {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  provider    IntegrationProvider
  displayName String
  baseUrl     String?
  /// Non-sensitive provider settings (project keys, field mappings).
  settings    Json                @default("{}")
  secretRef   String?
  status      IntegrationStatus   @default(disconnected)
  lastSyncAt  DateTime?
  lastError   String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  externalReferences ExternalReference[]

  @@unique([organizationId, provider, displayName])
  @@index([organizationId, status])
  @@map("integration_connections")
}

/// "This local entity is that remote thing." Generic on purpose: integrating a
/// new provider means adding an adapter, not migrating the schema.
model ExternalReference {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  entityType LinkableEntity
  entityId   String

  provider    IntegrationProvider
  externalId  String
  externalKey String?
  externalUrl String?
  metadata    Json?

  connectionId String?
  connection   IntegrationConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, provider, entityType, entityId, externalId])
  @@index([organizationId, entityType, entityId])
  @@index([organizationId, provider, externalId])
  @@map("external_references")
}
