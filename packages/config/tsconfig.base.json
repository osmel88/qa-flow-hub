{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "qa-flow-hub base",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "incremental": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    "strict": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noPropertyAccessFromIndexSignature": true,
    "useUnknownInCatchVariables": true,

    // Makes `{ a?: string }` refuse `{ a: undefined }`. It is why the codebase
    // spreads optional fields conditionally (`...(x === undefined ? {} : { x })`)
    // instead of passing `undefined` through: with Prisma, `{ where: { a:
    // undefined } }` means "no filter on a", so the difference between absent and
    // undefined is the difference between a query and a wider query.
    "exactOptionalPropertyTypes": true
  }
}
