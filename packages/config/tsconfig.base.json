{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "qa-flow-hub base",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "incremental": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    "strict": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noPropertyAccessFromIndexSignature": true,
    "useUnknownInCatchVariables": true

    // exactOptionalPropertyTypes is intentionally NOT enabled: Prisma's generated
    // types and Zod's output types model optional fields as `T | undefined`, and
    // turning it on produces noise without catching real defects here.
    // See docs/technical-debt.md.
  }
}
